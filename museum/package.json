{
  "name": "bobbies-gallery",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8950",
    "build": "node scripts/check-content.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8950",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "test:content": "node --test scripts/content-policy.test.mjs scripts/static-publish.test.mjs",
    "import:approved": "node scripts/import-approved.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
